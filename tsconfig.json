{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "e2e",
    "scripts",
    "tools",
    "*.ts"
  ]
}
